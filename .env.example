# The app always scrapes public hotel deal pages. No mock/example deals are served.
# Keep this true so local and production stay on live data.
LIVE_SCRAPE=true

# Public URL for canonical links, sitemap, and Open Graph. Set this in Vercel.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Production reads the Playwright scrape published by GitHub Actions.
# DEALS_CACHE_URL=https://raw.githubusercontent.com/LirreyUriel/dealsea/scrape-cache/deals-cache.json
